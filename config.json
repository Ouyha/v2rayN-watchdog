{
  // ===== v2rayN 断流监控配置（// 和 # 开头是注释，可以随便加） =====

  // 断流阈值（KB/s）：监控方向的网速 ≤ 这个值，并持续 LowDurationSeconds 秒，就点击「重启服务」
  "ThresholdKBps": 500.0,

  // 低速需要持续多少秒才触发重启（越大越不敏感）
  "LowDurationSeconds": 5,

  // 监控方向："up" = 上传(↑)    "down" = 下载(↓)    "updown" = 上传+下载合计
  "Direction": "up",

  // 正常速度门槛（KB/s）：最近 ActivityWindowSeconds 秒内，网速曾经 ≥ 这个值，才算「正在传输」
  // 建议设为你正常上传速度的一半左右；设为 0 可关闭活动量判断（任何时候低速都会重启）
  "ActivityFloorKBps": 800.0,

  // 活动窗口（秒）：超过这么久没出现过「正常速度」，判定为空闲，暂停自动重启
  "ActivityWindowSeconds": 60,

  // 点击「重启服务」后等待多少秒再继续判定（给核心重连留时间）
  "RestartGraceSeconds": 20,

  // 速度高于断流阈值并持续多少秒，视为已恢复，把「连续重启次数」清零
  "RecoverSeconds": 10,

  // 连续重启多少次仍未恢复，就播放声音报警（报警后暂停自动重启，直到再次出现正常速度）
  "MaxConsecutiveRestarts": 3,

  // 读取网速的间隔（毫秒）
  "PollIntervalMs": 1000,

  // 报警蜂鸣重复几轮
  "AlarmBeepRounds": 3,

  // 是否在本控制台窗口里绘制网速图表（true / false）
  "ShowChart": true,

  // 图表时间窗口（秒）：想多长都行，30 / 60 / 120 / 300 / 600 / 1800 都可以，
  // 时间轴刻度会跟着自动调整；窗口很短时一个采样点会自动占多列，所以不会断线
  "ChartSeconds": 300,

  // 图表采样间隔（秒）：每隔这么久往图里记一个点（判定的频率由 PollIntervalMs 决定，不受影响）
  // 1 = 每秒一个点，最右一列每秒都在动；2 更稳一点。设 0 表示 1 秒
  "SampleSeconds": 1,

  // 图表平滑窗口（秒）：画图前对数据做滑动平均，越大越"肉"、越小越有棱角，0 = 不平滑
  // 只影响画面，不影响断流判定。默认 8 秒比较有细节；嫌抖加到 15，想看原始尖峰设 0
  "ChartSmoothSeconds": 8,

  // 曲线字形："ascii"（默认，用 # 和 | 画细折线，任何终端都正常显示）
  //           "block"（用 ▁▂▃▄▅▆▇█ 画 1 行高的细方块线，1/8 行精度，更密集）
  "ChartGlyphs": "ascii"
}
